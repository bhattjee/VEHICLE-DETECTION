import cv2
import numpy as np

// Define the path to your MP4 video file (replace with your path)
video_path = '/your/path/here/carvideo1.mp4'

// Load the car cascade classifier (replace with your path)
car_cascade_src = '/your/path/here/cars.xml'  // Replace with your classifier path
car_cascade = cv2.CascadeClassifier(car_cascade_src)

// Open the video capture object
cap = cv2.VideoCapture(video_path)

// Check if video opened successfully
if not cap.isOpened():
    print("Error opening video file")
    exit()

total_car_count = 0  # Initialize total car count

// Process video frames
while True:
    // Read a frame from the video
    ret, frame = cap.read()

    // Check if frame is read correctly
    if not ret:
        print("No more frames in the video")
        break

    // Convert the frame to grayscale
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

    // Apply Gaussian blur for noise reduction
    blur = cv2.GaussianBlur(gray, (5, 5), 0)

    // Apply dilation to enhance car features
    dilated = cv2.dilate(blur, np.ones((3, 3)))

    // Perform morphological closing to remove small holes and irregularities
    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (1, 1))
    closed = cv2.morphologyEx(dilated, cv2.MORPH_CLOSE, kernel)

    // Detect cars using the classifier with adjustable parameters
    cars = car_cascade.detectMultiScale(closed, scaleFactor=2.1, minNeighbors=5, minSize=(20, 20))
    car_count = len(cars)

    // Draw rectangles around the detected cars
    for (x, y, w, h) in cars:
        cv2.rectangle(frame, (x, y), (x + w, y + h), (255, 0, 0), 2)

    // Update total car count
    total_car_count += car_count

    // Print car count and display the frame
    print(f"{car_count} cars found in current frame. Total: {total_car_count}")
    cv2.imshow('Car Detection', frame)

    // Exit loop if 'q' key is pressed
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

// Release video capture object and destroy windows
cap.release()
cv2.destroyAllWindows()

// Print final car count after video processing
print(f"Total cars detected in the video: {total_car_count/4}")
