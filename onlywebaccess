import cv2

# Replace 0 with the correct camera index if you have multiple cameras
cap = cv2.VideoCapture(0)

# Check if the camera opened successfully
if not cap.isOpened():
    print("Error opening camera")
    exit()

while True:
    # Capture frame-by-frame
    ret, frame = cap.read()

    # Check if frame is read correctly
    if not ret:
        print("Can't receive frame (stream end?). Exiting...")
        break

    # Display the resulting frame
    cv2.imshow('Camera', frame)

    # Press 'q' to quit
    if cv2.waitKey(1) == ord('q'):
        break

# When everything done, release the capture
cap.release()
cv2.destroyAllWindows()

# Optional: Capture a photo on pressing a specific key (e.g., 'p')
while True:
    # Capture frame-by-frame
    ret, frame = cap.read()

    # Check if frame is read correctly
    if not ret:
        print("Can't receive frame (stream end?). Exiting...")
        break

    # Display the resulting frame
    cv2.imshow('Camera', frame)

    # Press 'p' to capture a photo and 'q' to quit
    if cv2.waitKey(1) == ord('p'):
        # Define filename (replace 'capture.jpg' with your desired name)
        filename = 'capture.jpg'
        cv2.imwrite(filename, frame)
        print(f"Photo captured and saved as: {filename}")
        break
    elif cv2.waitKey(1) == ord('q'):
        break

# When everything done, release the capture
cap.release()
cv2.destroyAllWindows()
